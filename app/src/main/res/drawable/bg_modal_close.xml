    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/modal_close_bg" />
        </shape>
    </item>
</selector>
