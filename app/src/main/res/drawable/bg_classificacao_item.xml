<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selecionado (Tabela ativa) -->
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/classificacao_selected" />
        </shape>
    </item>
    <!-- Focado (navegação por controle/TV) -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/classificacao_focus" />
        </shape>
    </item>
    <!-- Estado normal -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/classificacao_normal" />
        </shape>
    </item>
</selector>
