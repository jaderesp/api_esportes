<?xml version="1.0" encoding="utf-8"?>
<!-- Opção "Tabela" (coluna lateral) — estilo dos demais itens da coluna.
     Selecionado = verde da marca; focado = azul de foco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_brand_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_brand" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#242F89FF" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_focus" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>