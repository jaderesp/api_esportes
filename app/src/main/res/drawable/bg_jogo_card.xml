<?xml version="1.0" encoding="utf-8"?>
<!-- Card de jogo (estado normal) — identidade do widget web: gradiente
     translúcido + borda sutil + cantos 13dp (glassmorphism). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="300"
        android:endColor="#120A1728"
        android:startColor="#1A0F223A" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_line" />
    <corners android:radius="13dp" />
</shape>