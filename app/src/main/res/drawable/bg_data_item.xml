<?xml version="1.0" encoding="utf-8"?>
<!-- Botão de data (coluna lateral) — estilo .data-btn do widget:
     normal translúcido, focado/selecionado com borda verde da marca. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_brand_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_brand" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_brand_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_brand" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>