<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão do chip de canal (estado normal): gradiente escuro sutil + borda translúcida -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="#2E3A46"
        android:startColor="#1C2833" />
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
    <corners android:radius="12dp" />
    <size
        android:height="20dp"
        android:width="100dp" />
</shape>