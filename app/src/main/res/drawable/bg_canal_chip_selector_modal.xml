<?xml version="1.0" encoding="utf-8"?>
<!-- Selector do chip de canal DENTRO do modal: destaca quando focado (TV). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_canal_chip_foco" />
