<?xml version="1.0" encoding="utf-8"?>
<!--
  Modal de detalhes de um canal de transmissão (bottom sheet).
  Mostra logo, nome do canal, servidor e a URL de transmissão.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Escurece o fundo para dar destaque ao modal -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/modal_scrim" />

    <!-- Painel inferior -->
    <LinearLayout
        android:id="@+id/panelCanal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_modal_sheet"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_12sdp">

        <!-- Alça indicando que dá para fechar -->
        <View
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:background="@drawable/bg_modal_handle" />

        <!-- Título + botão fechar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_6sdp"
            android:paddingBottom="@dimen/_4sdp">

            <TextView
                android:id="@+id/txtModalTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/modal_canal_title"
                android:textColor="@color/white"
                android:textSize="@dimen/_9sdp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseCanal"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:background="@drawable/bg_modal_close"
                android:contentDescription="@string/modal_canais_close"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_close_white" />
        </LinearLayout>

        <!-- Cabeçalho do canal: logo + nome -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingTop="@dimen/_4sdp"
            android:paddingBottom="@dimen/_8sdp">

            <ImageView
                android:id="@+id/ivCanalLogo"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="@dimen/_48sdp"
                android:background="@drawable/bg_modal_canal_logo"
                android:contentDescription="Logo do canal"
                android:padding="@dimen/_4sdp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_10sdp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCanalNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCanalServidor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/modal_text_secondary"
                    android:textSize="@dimen/_6sdp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/modal_divider" />

        <!-- Dados da transmissão -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingTop="@dimen/_8sdp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/modal_canal_transmissao"
                android:textColor="@color/modal_section_title"
                android:textSize="@dimen/_7sdp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTransmissionUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@drawable/bg_canal_chip"
                android:padding="@dimen/_6sdp"
                android:selectAllOnFocus="true"
                android:textColor="@color/white"
                android:textIsSelectable="true"
                android:textSize="@dimen/_5sdp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
